{
  "manifest_version": 3,
  "name": "AI Recipe Manager: Shop my list",
  "description": "Puts your AI Recipe Manager grocery list into your store's online cart. Stops at the cart; you place the order.",
  "version": "0.1.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Shop my list",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage", "sidePanel", "scripting", "activeTab", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://puokewpqhparawdcwkbw.supabase.co/*"],
  "web_accessible_resources": [],
  "minimum_chrome_version": "116"
}
